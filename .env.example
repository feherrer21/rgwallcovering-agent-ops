# Copia este fichero a .env y rellena los valores.
# .env está en .gitignore: nunca se commitea. En despliegue estos valores van
# al almacén de secretos de la plataforma, nunca al repositorio y nunca a un
# documento o captura de pantalla.

# --- Pasarela de modelos (obligatorio) ------------------------------------
#
# Política de Perficient: el coursework se rutea por el gateway de la empresa,
# no por keys personales de proveedor. Se obtiene en myapplications.microsoft.com
# -> Portkey -> Getting Started. El acceso se provisiona semanalmente tras la
# inscripción a la ruta de aprendizaje.
#
# Presupuesto: $50 USD para toda la ruta. Resetearlo requiere ticket a
# support@perficient.com con aprobación del jefe directo.

PORTKEY_API_KEY=
# PORTKEY_BASE_URL=https://portkeygateway.perficient.com/v1

# Identificadores del catálogo del workspace. NO se adivinan: se resuelven con
#   curl https://portkeygateway.perficient.com/v1/models \
#        -H "x-portkey-api-key: $PORTKEY_API_KEY"
# La guía de entorno se contradice a sí misma en la fila de Gemini, así que la
# fuente de verdad es el catálogo vivo.
MODELO_BARATO=
MODELO_FRONTIER=

# --- Recuperación (opcional, hay valores por defecto en config.py) ---------
# PISO_RELEVANCIA=0.62
# TOP_K=5
# MAX_POR_FUENTE=2

# --- Presupuestos del bucle (opcional) ------------------------------------
# REINTENTOS_POR_TOOL=2
# MAX_LLAMADAS_POR_LEAD=12

# --- Correo ---------------------------------------------------------------
#
# MIENTRAS DESARROLLAS: la cuenta de prueba, NUNCA la de Ronald. Un lead de
# prueba en su bandeja es una llamada perdida a una persona que no existe.
#
# SMTP_PASSWORD es una contraseña de APLICACIÓN de Google (16 caracteres), no
# la contraseña de la cuenta. Requiere verificación en dos pasos activa.

SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# CORREO_REMITENTE=

# Dónde llegan las escalaciones. Es la bandeja de Ronald en producción; la
# cuenta de prueba mientras se construye.
CORREO_ESCALACION=

# --- Calendario -----------------------------------------------------------
#
# OAuth: el refresh token se genera UNA sola vez con autorización manual y se
# guarda como secreto. La Calendar API no acepta contraseñas de aplicación
# como SMTP, así que este camino no tiene atajo.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# CALENDAR_ID=primary

# --- Acceso a la aplicación -----------------------------------------------
#
# Secreto compartido que controla quién puede abrir la app. Es una puerta, no
# una autorización: lo que evidencia el criterio S2 es el registro de
# aprobación del gate, no el haber entrado. Ver 03_spec.md §12.1.

APP_PASSWORD=
